# Cloudflare Turnstile. These are Cloudflare's test keys, which always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Only for scripts/add-admin.mts on your own machine. Never expose it to the
# browser or set it in Vercel: the app itself does not use it.
