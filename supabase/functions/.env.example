# Copy to supabase/functions/.env for local development. In staging and
# production, set these with `supabase secrets set`.

# Any long random string. Changing it resets every IP-based rate limit.
IP_HASH_SALT=local-development-salt-change-me

# Cloudflare's test secret, which always passes. Use the real one in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
